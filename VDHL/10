entity examen is
  port(
    p : in std_logic;
    v: in std_logic_vector(2 downto 0);
    f : out std_logic;
);
end examen;

architecture concurrente of examen is
  begin
    f <= p and (v(1) or v(2) or v(3)) or (v(1) and v(2) and v(3));
end concurrente;

architecture estructural of examen is 
    Signal or1, and1, and2: std_logic;
  begin
    primeror: entity work.or3 port map (v(0),v(1),v(2),or1);
    primerand: entity work.and3 port map (v(0),v(1),v(2),and1);
    segundoand: entity work.and2 port map (v(3),or1,and2);
    segundoor: entity work.or2 port map (and2,and1,f);
end estructural;


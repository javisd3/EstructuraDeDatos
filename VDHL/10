entity examen is
  port(
    G, T45, T60, H , enable: in std_logic;
    A : out std_logic
);
end examen;

architecture concurrente of examen is
begin
  A <= T60 or (G and T45) or (T45 and H) or (G and H);
end concurrente;

architecture estructural of examen is
signal dec_in: std_logic_vector(2 downto 0);
signal m : std_logic_vector(7 downto 0);
signal or1, and1: std_logic;

begin
  dec_in(2) <= G;
  dec_in(1) <= T45;
  dec_in(0) <= T60;
  
  deco3a8: entity work.deco3a8 port map(enable, dec_in, m);
  Puerta_or1: entity work.or2 port map (m(2),m(4),or1);
  Puerta_and1: entity work.and2 port map (or1,H,and1);
  orfinal: entity work.or4 port map (m(3),and1,m(6),m(7),A);
  
end estructural;

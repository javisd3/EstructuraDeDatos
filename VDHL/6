library ieee;
use ieee.std_logic_1164.all;

-- Este circuito es detector de la secuencia "1100"
entity practica_2 is
	port (clk, rst, x: in std_logic;
	      z: out std_logic);
end practica_2;

architecture estructural_D of practica_2 is
	signal q: std_logic_vector (2 downto 0);
	signal d: std_logic_vector (2 downto 0);
begin
	d(2) <= not x and q(1) and q(0);
	d(1) <= (q(1) and not(q(0))) or (x and not(q(1)) and q(0));
	d(0) <= (x and not(q(1)) and not(q(0))) or (x and q(1) and q(0)) or (not(x) and q(1) and not(q(0))); 
	
	biestableQ2: entity work.flipflopD port map(clk, rst, d(2), q(2));
	biestableQ1: entity work.flipflopD port map(clk, rst, d(1), q(1));
	biestableQ0: entity work.flipflopD port map(clk, rst, d(0), q(0));

	z <= q(2);
end estructural_D;

architecture estructural_JK of practica_2 is
	signal q: std_logic_vector (2 downto 0);
	signal j: std_logic_vector (2 downto 0);
    signal k: std_logic_vector (2 downto 0);
	
begin
	j(2) <= not x and q(1) and q(0);
	j(1) <= x and q(0) and not q(2);
	j(0) <= x and q(1);

    k(2) <= '1';
	k(1) <= q(0);
	k(0) <= not x and not q(1);
	
	biestableQ2: entity work.flipflopJK port map(clk, rst, j(2), k(2), q(2));
	biestableQ1: entity work.flipflopJK port map(clk, rst, j(1), k(1), q(1));
	biestableQ0: entity work.flipflopJK port map(clk, rst, j(0), k(0), q(0));

	z <= q(2);
end estructural_JK;
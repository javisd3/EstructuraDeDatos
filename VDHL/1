librery ieee;
use ieee.std_logic_1164.all;

entity nombre is
    port (
        h, l, t, d: in std_logic;
        v, a : out std_logic
    );
end nombre;


architecture concurrente of nombre is 
begin
    v <= d and (not l) and ((not h) or t);
    a <= (not d) and (not l) and ((not h) or t);
end concurrente;


architecture estructural of nombre is 
    signal sel_mux : std_logic_vector(2 downto 0);
    signal data_mux: std_logic_vector(7 downto 0);

    signal not_d, not_l, not_h, not_t : std_logic;
    signal or_ht:std_logic;

begin
    sel_mux(2) <= h;
    sel_mux(1) <= l;
    sel_mux(0) <= t;

    data_mux(7) <= '0';
    data_mux(6) <= '0';
    data_mux(5) <= d;
    data_mux(4) <= '0';   
    data_mux(3) <= '0';
    data_mux(2) <= '0';
    data_mux(1) <= d;
    data_mux(0) <= d;

    mux_valvula: entity work.mux8a1 port map (
        enable <= '1',
        x <= data_mux,
        sel <= sel_mux,
        y <= v
    );

    not_d: entity work.not1 port map (d, not_d);
    not_l: entity work.not1 port map (l, not_l);
    not_h: entity work.not1 port map (h, not_h);

    or_aux: entity work.or2 port map (not_h, t, or_ht);
    and_alarma: entity work.and3 port map(not_d, not_l, or_ht, a);

end estructural;

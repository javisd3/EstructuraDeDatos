-- Este es el "manual de instrucciones" del chip (La carcasa externa)
entity mux8a1 is
    port (
        enable : in  std_logic;                     -- Pin 1: Encendido
        x      : in  std_logic_vector(7 downto 0);  -- Pines 2 al 9: Entradas de datos
        sel    : in  std_logic_vector(2 downto 0);  -- Pines 10 al 12: Selección
        y      : out std_logic                      -- Pin 13: Salida
    );
end mux8a1;

-- Y esta es la circuitería que lleva por dentro (Su arquitectura)
architecture concurrente of mux8a1 is
begin
    -- Funciona solo si el enable está encendido ('1')
    with sel select
        y <= x(0) when "000",
             x(1) when "001",
             x(2) when "010",
             x(3) when "011",
             x(4) when "100",
             x(5) when "101",
             x(6) when "110",
             x(7) when "111",
             '0'  when others;
             
end concurrente;
architecture comportamental of practica_2 is
    -- Definimos los estados con nombres reales
    type tipo_estado is (S0, S1, S2, S3, S4);
    signal estado_actual, estado_siguiente : tipo_estado;
begin

    -- Proceso 1: La memoria (El reloj que actualiza el estado)
    process(clk, rst)
    begin
        if rst = '1' then
            estado_actual <= S0;
        elsif rising_edge(clk) then
            estado_actual <= estado_siguiente;
        end if;
    end process;

    -- Proceso 2: La lógica de saltos (Sustituye a Karnaugh)
    process(estado_actual, x)
    begin
        case estado_actual is
            when S0 =>
                if x = '1' then estado_siguiente <= S1;
                else estado_siguiente <= S0;
                end if;
            when S1 =>
                -- ... y así sucesivamente para todos los estados
        end case;
    end process;

    -- Salida Moore
    z <= '1' when estado_actual = S4 else '0';

end comportamental;
architecture puramente_estructural of practica_2 is
    signal q, d : std_logic_vector(2 downto 0);
    signal cable_not_x, cable_and_1 : std_logic;
begin
    -- En lugar de "not x", instancias un inversor físico
    inversor1: entity work.puerta_NOT port map(in_A => x, out_Y => cable_not_x);
    
    -- En lugar de "and", instancias una puerta AND de 3 entradas
    and_d2: entity work.puerta_AND3 port map(
        in_A => cable_not_x, 
        in_B => q(1), 
        in_C => q(0), 
        out_Y => d(2)
    );
    
    -- Y finalmente el biestable
    puertaq2: entity work.flipflopD port map(clk, rst, d(2), q(2));
    
    -- ... (Imagina hacer esto para todas las ecuaciones, ¡una locura de líneas!)
end puramente_estructural;


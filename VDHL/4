library ieee;
use ieee.std_logic_1164.all;

-- Este circuito es un comparador de datos de 2 bits en binario puro. 
-- Funcionamiento:
-- Si enable es '0', la salida z vale "00".
-- Si enable es '1':
-- 	             Si x<y, la salida z vale "01".
-- 	             Si x>y, la salida z vale "10".
-- 	             Si x=y, la salida z vale "11".
entity practica_1 is
	port (x,y: in std_logic_vector(1 downto 0);
	      enable: in std_logic;
	      z: out std_logic_vector(1 downto 0));
end practica_1;

-- Arquitectura del apartado a)
architecture concurrente_sdp of practica_1 is
begin

    -- Asignación concurrente para Z(1)
    z(1) <= enable and (
        (not y(1) and not y(0)) or 
        (x(1) and x(0)) or 
        (x(0) and not y(1)) or 
        (x(1) and not y(1)) or 
        (x(1) and not y(0))
    );

    -- Asignación concurrente para Z(0)
    z(0) <= enable and (
        (not x(1) and not x(0)) or 
        (y(1) and y(0)) or 
        (not x(1) and y(0)) or 
        (not x(1) and y(1)) or 
        (not x(0) and y(1))
    );

end concurrente_sdp;

-- Arquitectura del apartado b)
architecture concurrente_pds of practica_1 is
begin

    -- Asignación concurrente para Z(1)
    z(1) <= enable and (
        (x(1) or  not y(1)) and
        (x(1) or x(0) or not y(0)) and
        (x(0) or not y(1) or not y(0))
    );

    -- Asignación concurrente para Z(0)
    z(0) <= enable and (
        (not x(1) or y(1)) and
        (not x(0) or y(1) or y(0)) and
        (not x(1) or not x(0) or y(0))
    );

end concurrente_pds;

-- Arquitectura del apartado c)
architecture estructural_nand of practica_1 is
    -- Señales para las entradas negadas
    signal nx1, nx0, ny1, ny0: std_logic;
    
    -- Señales intermedias para la salida de las puertas NAND de nivel 1 (los "productos")
    signal t11, t12, t13, t14, t15: std_logic; -- Para Z(1)
    signal t01, t02, t03, t04, t05: std_logic; -- Para Z(0)

begin
    -- 1. Inversores creados puenteando las entradas de puertas NAND2
    inv_x1: entity work.nand2 port map (x(1), x(1), nx1);
    inv_x0: entity work.nand2 port map (x(0), x(0), nx0);
    inv_y1: entity work.nand2 port map (y(1), y(1), ny1);
    inv_y0: entity work.nand2 port map (y(0), y(0), ny0);

    ---------------------------------------------------------
    -- Z(1): Detección de (X >= Y) y Enable
    ---------------------------------------------------------
    -- Nivel 1: NANDs equivalentes a los términos AND
    n11: entity work.nand3 port map (enable, x(1), x(0), t11);
    n12: entity work.nand3 port map (enable, x(1), ny1, t12);
    n13: entity work.nand3 port map (enable, x(1), ny0, t13);
    n14: entity work.nand3 port map (enable, x(0), ny1, t14);
    n15: entity work.nand3 port map (enable, ny1, ny0, t15);

    -- Nivel 2: NAND equivalente a la suma OR final
    n1_out: entity work.nand5 port map (t11, t12, t13, t14, t15, z(1));

    ---------------------------------------------------------
    -- Z(0): Detección de (X <= Y) y Enable
    ---------------------------------------------------------
    -- Nivel 1: NANDs equivalentes a los términos AND (simetría)
    n01: entity work.nand3 port map (enable, y(1), y(0), t01);
    n02: entity work.nand3 port map (enable, y(1), nx1, t02);
    n03: entity work.nand3 port map (enable, y(1), nx0, t03);
    n04: entity work.nand3 port map (enable, y(0), nx1, t04);
    n05: entity work.nand3 port map (enable, nx1, nx0, t05);

    -- Nivel 2: NAND equivalente a la suma OR final
    n0_out: entity work.nand5 port map (t01, t02, t03, t04, t05, z(0));

end estructural_nand;	

-- Arquitectura del apartado d)
architecture estructural_nor of practica_1 is
    -- Señales para las variables negadas
    signal nx1, nx0, ny1, ny0, nenable: std_logic;
    
    -- Señales intermedias para la salida de las puertas NOR de nivel 1 (las "sumas")
    signal t11, t12, t13: std_logic; -- Para Z(1)
    signal t01, t02, t03: std_logic; -- Para Z(0)

begin
    -- 1. Inversores creados puenteando las entradas de puertas NOR2
    inv_x1: entity work.nor2 port map (x(1), x(1), nx1);
    inv_x0: entity work.nor2 port map (x(0), x(0), nx0);
    inv_y1: entity work.nor2 port map (y(1), y(1), ny1);
    inv_y0: entity work.nor2 port map (y(0), y(0), ny0);
    inv_en: entity work.nor2 port map (enable, enable, nenable);

    ---------------------------------------------------------
    -- Z(1): Detección de (X >= Y) y Enable
    ---------------------------------------------------------
    -- Nivel 1: NORs equivalentes a los términos OR
    n11: entity work.nor2 port map (x(1), ny1, t11);
    n12: entity work.nor3 port map (x(1), x(0), ny0, t12);
    n13: entity work.nor3 port map (x(0), ny1, ny0, t13);

    -- Nivel 2: NOR de 4 entradas equivalente al producto AND final
    -- Se incluye el enable negado para que funcione como multiplicador
    n1_out: entity work.nor4 port map (t11, t12, t13, nenable, z(1));

    ---------------------------------------------------------
    -- Z(0): Detección de (X <= Y) y Enable
    ---------------------------------------------------------
    -- Nivel 1: NORs equivalentes a los términos OR (simetría)
    n01: entity work.nor2 port map (nx1, y(1), t01);
    n02: entity work.nor3 port map (nx0, y(1), y(0), t02);
    n03: entity work.nor3 port map (nx1, nx0, y(0), t03);

    -- Nivel 2: NOR de 4 entradas equivalente al producto AND final
    n0_out: entity work.nor4 port map (t01, t02, t03, nenable, z(0));

end estructural_nor;

-- Arquitectura del apartado e)
architecture estructural_deco4a16 of practica_1 is
    -- Señal de 4 bits para conectar a la entrada del decodificador
    signal dec_in: std_logic_vector(3 downto 0);
    
    -- Señal de 16 bits para recoger los minitérminos a la salida del decodificador
    signal m: std_logic_vector(15 downto 0);
    -- Señales intermedias para las sumas parciales de las puertas OR
    signal z1_a, z1_b: std_logic;
    signal z0_a, z0_b: std_logic;
begin
    -- 1. Agrupamos las entradas X e Y en un solo vector de 4 bits
    -- dec_in(3) = X1, dec_in(2) = X0, dec_in(1) = Y1, dec_in(0) = Y0
    dec_in(3) <= x(1);
    dec_in(2) <= x(0);
    dec_in(1) <= y(1);
    dec_in(0) <= y(0);
    -- 2. Instanciamos el decodificador
    -- Pasamos la señal enable original para que apague todo si es 0
    deco: entity work.deco4a16 port map (enable, dec_in, m);
    -- Z(1): Detección de (X >= Y)
    -- Sumamos los 10 minitérminos: 0, 4, 5, 8, 9, 10, 12, 13, 14, 15
    or_z1_a: entity work.or5 port map (m(0), m(4), m(5), m(8), m(9), z1_a);
    or_z1_b: entity work.or5 port map (m(10), m(12), m(13), m(14), m(15), z1_b);
    or_z1_out: entity work.or2 port map (z1_a, z1_b, z(1));
    -- Z(0)
    or_z0_a: entity work.or5 port map (m(0), m(1), m(2), m(3), m(5), z0_a);
    or_z0_b: entity work.or5 port map (m(6), m(7), m(10), m(11), m(15), z0_b);
    or_z0_out: entity work.or2 port map (z0_a, z0_b, z(0));
end estructural_deco4a16;

-- Arquitectura del apartado f)
architecture estructural_deco3a8 of practica_1 is
    -- Cable de 3 hilos para compartir entre los dos decodificadores (X0, Y1, Y0)
    signal dec_in: std_logic_vector(2 downto 0);
    
    -- Cables de 8 hilos para las salidas de cada decodificador
    signal m_bajo: std_logic_vector(7 downto 0);
    signal m_alto: std_logic_vector(7 downto 0);
    
    -- Un cable gordo de 16 hilos para juntar todos los minitérminos del 0 al 15
    signal m: std_logic_vector(15 downto 0);
    
    -- Cables para encender un chip u otro
    signal not_x1: std_logic;
    signal en_bajo, en_alto: std_logic;
    
    -- Cables para las sumas finales
    signal z1_a, z1_b: std_logic;
    signal z0_a, z0_b: std_logic;

begin
    -- 1. Preparamos el cable de 3 hilos compartido
    dec_in(2) <= x(0);
    dec_in(1) <= y(1);
    dec_in(0) <= y(0);

    -- 2. Lógica del "Interruptor" usando X1 y el Enable global
    inv_x1: entity work.not1 port map(x(1), not_x1);
    
    -- El chip bajo se enciende si (Enable = 1) Y (X1 = 0)
    and_en_bajo: entity work.and2 port map(enable, not_x1, en_bajo);
    
    -- El chip alto se enciende si (Enable = 1) Y (X1 = 1)
    and_en_alto: entity work.and2 port map(enable, x(1), en_alto);

    -- 3. Conectamos los dos chips decodificadores
    deco_inf: entity work.deco3a8 port map(en_bajo, dec_in, m_bajo);
    deco_sup: entity work.deco3a8 port map(en_alto, dec_in, m_alto);

    -- 4. Juntamos los dos manojos de 8 cables en un solo bus de 16 cables
    -- Los primeros 8 hilos (del 0 al 7) vienen del decodificador bajo
    m(7 downto 0) <= m_bajo;
    -- Los siguientes 8 hilos (del 8 al 15) vienen del decodificador alto
    m(15 downto 8) <= m_alto;

    ---------------------------------------------------------
    -- Z(1): Detección de (X >= Y)
    ---------------------------------------------------------
    -- Sumamos los 10 minitérminos: 0, 4, 5, 8, 9, 10, 12, 13, 14, 15
    or_z1_a: entity work.or5 port map (m(0), m(4), m(5), m(8), m(9), z1_a);
    or_z1_b: entity work.or5 port map (m(10), m(12), m(13), m(14), m(15), z1_b);
    or_z1_out: entity work.or2 port map (z1_a, z1_b, z(1));

    ---------------------------------------------------------
    -- Z(0): Detección de (X <= Y)
    ---------------------------------------------------------
    -- Sumamos los 10 minitérminos: 0, 1, 2, 3, 5, 6, 7, 10, 11, 15
    or_z0_a: entity work.or5 port map (m(0), m(1), m(2), m(3), m(5), z0_a);
    or_z0_b: entity work.or5 port map (m(6), m(7), m(10), m(11), m(15), z0_b);
    or_z0_out: entity work.or2 port map (z0_a, z0_b, z(0));

end estructural_deco3a8;

-- Arquitectura del apartado g)
architecture estructural_mux16a1 of practica_1 is
    -- Un manojo de 4 cables para agrupar nuestros "botones de selección"
    signal sel_in: std_logic_vector(3 downto 0);
    
    -- Los cables pre-configurados con los '1's y '0's de nuestras tablas
    signal datos_para_z1: std_logic_vector(15 downto 0);
    signal datos_para_z0: std_logic_vector(15 downto 0);

begin
    -- 1. Empalmamos los 4 cables de entrada al manojo de selección
    sel_in(3) <= x(1);
    sel_in(2) <= x(0);
    sel_in(1) <= y(1);
    sel_in(0) <= y(0);

    -- 2. Preparamos los 16 cables que entrarán al MUX de Z1
    -- Leemos la tabla de verdad de abajo a arriba (del 15 al 0)
    datos_para_z1 <= "1111011100110001";

    -- 3. Preparamos los 16 cables que entrarán al MUX de Z0
    datos_para_z0 <= "1000110011101111";

    -- 4. Soldamos el CHIP 1 (El de Z1)
    mux_z1: entity work.mux16a1 port map (
        enable => enable,       -- Pin de encendido
        x      => datos_para_z1, -- Los 16 cables de datos
        sel    => sel_in,       -- Los 4 cables de selección
        y      => z(1)          -- La salida final
    );

    -- 5. Soldamos el CHIP 2 (El de Z0)
    mux_z0: entity work.mux16a1 port map (
        enable => enable,       -- Pin de encendido
        x      => datos_para_z0, -- Los 16 cables de datos
        sel    => sel_in,       -- Los 4 cables de selección
        y      => z(0)          -- La salida final
    );

end estructural_mux16a1;

-- Arquitectura del apartado h)
architecture estructural_mux4a1 of practica_1 is
    -- Cables para el "mando a distancia" (las líneas de selección)
    signal sel_in: std_logic_vector(1 downto 0);
    
    -- Cables preconfigurados que enchufaremos a las entradas de los multiplexores
    signal data_z1: std_logic_vector(3 downto 0);
    signal data_z0: std_logic_vector(3 downto 0);
    
    -- Cables para los mini-circuitos auxiliares
    signal not_x0, not_y0: std_logic;
    signal aux_z1, aux_z0: std_logic;

begin
    -- =========================================================================
    -- CONFIGURACIÓN DEL "MANDO A DISTANCIA" (Líneas de selección)
    -- =========================================================================
    -- Conectamos los "hermanos mayores" (X1 e Y1) para que decidan el canal
    sel_in(1) <= x(1);
    sel_in(0) <= y(1);

    -- =========================================================================
    -- BLOQUE 1: LOS MINI-CIRCUITOS AUXILIARES (Los "hermanos pequeños")
    -- =========================================================================
    -- 1. Inversores para X0 e Y0 usando la puerta NOT1 del archivo básico
    inv_x0: entity work.not1 port map(x(0), not_x0);
    inv_y0: entity work.not1 port map(y(0), not_y0);
    
    -- 2. aux_z1 = X0 + not_Y0 (Este cable decidirá los empates para Z1)
    or_z1:  entity work.or2 port map(x(0), not_y0, aux_z1);
    
    -- 3. aux_z0 = not_X0 + Y0 (Este cable decidirá los empates para Z0)
    or_z0:  entity work.or2 port map(not_x0, y(0), aux_z0);

    -- =========================================================================
    -- PREPARAR LOS ENCHUFES (Las entradas de datos D3, D2, D1, D0)
    -- =========================================================================
    -- Cables para Z1 (X >= Y):
    data_z1(3) <= aux_z1; -- Canal 3 (X1=1, Y1=1): Empate, decide aux_z1
    data_z1(2) <= '1';    -- Canal 2 (X1=1, Y1=0): X gana por goleada
    data_z1(1) <= '0';    -- Canal 1 (X1=0, Y1=1): Y gana por goleada
    data_z1(0) <= aux_z1; -- Canal 0 (X1=0, Y1=0): Empate, decide aux_z1

    -- Cables para Z0 (X <= Y):
    data_z0(3) <= aux_z0; -- Canal 3 (X1=1, Y1=1): Empate, decide aux_z0
    data_z0(2) <= '0';    -- Canal 2 (X1=1, Y1=0): X gana por goleada
    data_z0(1) <= '1';    -- Canal 1 (X1=0, Y1=1): Y gana por goleada
    data_z0(0) <= aux_z0; -- Canal 0 (X1=0, Y1=0): Empate, decide aux_z0

    -- =========================================================================
    -- BLOQUE 2 y 3: SOLDAR LOS MULTIPLEXORES
    -- =========================================================================
    -- Instanciamos el MUX para Z1
    mux_z1: entity work.mux4a1 port map (
        enable => enable,   -- Pin general de encendido
        x      => data_z1,  -- El manojo de 4 cables que acabamos de preparar
        sel    => sel_in,   -- Los "hermanos mayores" seleccionando
        y      => z(1)      -- Salida final Z1
    );

    -- Instanciamos el MUX para Z0
    mux_z0: entity work.mux4a1 port map (
        enable => enable,   -- Pin general de encendido
        x      => data_z0,  -- El manojo de 4 cables que acabamos de preparar
        sel    => sel_in,   -- Los "hermanos mayores" seleccionando
        y      => z(0)      -- Salida final Z0
    );

end estructural_mux4a1;
